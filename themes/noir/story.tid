title: $:/themes/tiddlywiki/noir/story
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** Story river, the lit stage & typography
**
** The tiddler is a lit surface, not a card. It has no border, no cast shadow,
** no rim highlight and no glow — it separates from the surround because it is
** the thing the light is falling on. The story river carries that surface
** continuously; the page falls away at its edges.
*/

.tc-story-river {
	padding-top: var(--n-space-lg);
	padding-bottom: var(--n-space-xl);
	background: var(--n-stage);
}

/*
** The stage.
**
** Storyview/popup-safe: no transform / filter / will-change / animation here.
** No hover treatment either — a panel of text is not an interactive element,
** and lighting one under the pointer is motion with nothing to say.
*/
.tc-tiddler-frame {
	--n-frame-pad-x: var(--n-space-md);
	margin-bottom: var(--n-space-lg);
	padding: 0 var(--n-frame-pad-x) var(--n-space-md);
	background: none;
	border: none;
	border-radius: 0;
	box-shadow: none;
}

/* Edit mode gets the one accent edge in the story: a hard light-line along the
   top of the record being worked on. */
.tc-tiddler-frame.tc-tiddler-edit-frame {
	border-top: 2px solid var(--n-accent);
	padding-top: var(--n-space-md);
	background: var(--n-hover);
}

@media (max-width: 769px) {
	.tc-tiddler-frame {
		--n-frame-pad-x: var(--n-space-sm);
		margin-bottom: var(--n-space-md);
	}
	.tc-story-river {
		padding-top: var(--n-space-md);
		padding-bottom: var(--n-space-lg);
	}
}

/* Title — geometric display, tightly tracked, and NOT glowing. It carried
   `text-shadow: 0 0 22px` before; a halo on text is a named tell and it eats
   the very contrast the dark palette exists to protect. */
.tc-tiddler-title {
	margin-bottom: var(--n-space-sm);
	padding-bottom: var(--n-space-2xs);
	border-bottom: 1px solid var(--n-line);
}
.tc-titlebar h2,
.tc-site-title,
.tc-tiddler-body h1,
.tc-tiddler-body h2,
.tc-tiddler-body h3,
.tc-tiddler-body h4,
.tc-tiddler-body h5,
.tc-tiddler-body h6 {
	font-family: var(--n-display);
	font-style: normal;
	font-weight: 600;
	letter-spacing: -0.028em;
	line-height: 1.16;
	text-wrap: balance;
	text-shadow: none;
	/* Tiddler titles are routinely long unbroken strings — system paths like
	   $:/themes/tiddlywiki/noir/variables have no space to break at. */
	overflow-wrap: anywhere;
	min-width: 0;
}
.tc-titlebar h2 {
	font-size: clamp(1.6rem, 1.35rem + 1.1vw, 2.25rem);
	color: <<colour tiddler-title-foreground>>;
}

.tc-tiddler-subtitle {
	font-family: var(--n-mono);
	font-size: 0.76rem;
	letter-spacing: 0.02em;
	color: var(--n-faint);
}

.tc-tags-wrapper { margin-top: var(--n-space-3xs); }

/* Reading column */
.tc-tiddler-body {
	font-family: var(--n-body);
	font-size: clamp(1rem, 0.97rem + 0.16vw, 1.08rem);
	line-height: 1.66;
	color: var(--n-ink);
	font-feature-settings: "kern" 1, "liga" 1, "calt" 1;
	text-wrap: pretty;
	margin-top: var(--n-space-sm);
	max-width: var(--n-measure);
}
.tc-tiddler-body p { margin: 0 0 1em 0; }
.tc-tiddler-body h1 { font-size: 1.8em; margin: 1.4em 0 0.5em; }
.tc-tiddler-body h2 { font-size: 1.46em; margin: 1.3em 0 0.45em; }
.tc-tiddler-body h3 { font-size: 1.22em; margin: 1.2em 0 0.4em; }
.tc-tiddler-body h4 { font-size: 1.06em; margin: 1.1em 0 0.35em; }
.tc-tiddler-body h5, .tc-tiddler-body h6 {
	font-size: 0.86em;
	letter-spacing: 0.09em;
	text-transform: uppercase;
	color: var(--n-muted);
	margin: 1.1em 0 0.3em;
}

/* Links — one signal. The ink moves toward the accent and stays legible; it
   used to also swap the underline colour AND fire a 16px text-shadow halo,
   which on the light palette took the hovered link to 2.63:1. */
.tc-tiddler-body a.tc-tiddlylink,
.tc-tiddler-body a.tc-tiddlylink-resolves {
	color: var(--n-accent-ink);
	text-decoration: underline;
	text-decoration-thickness: 1px;
	text-decoration-color: var(--n-line-strong);
	text-underline-offset: 0.16em;
	transition: color var(--n-dur) var(--n-ease);
}
.tc-tiddler-body a.tc-tiddlylink:not(.tc-plugin-info):hover {
	color: var(--n-accent-bright);
	text-shadow: none;
}
.tc-tiddler-body a.tc-tiddlylink-missing { text-decoration-style: dotted; opacity: 0.85; }

/* Markers in the muted ink — a bullet is not a signal */
.tc-tiddler-body ul, .tc-tiddler-body ol { padding-left: 1.4em; }
.tc-tiddler-body li { margin: 0.22em 0; }
.tc-tiddler-body li::marker { color: var(--n-muted); }

/* Block quote — an indent and a hard edge. The accent bar over an accent wash
   made every quotation read as a callout. */
.tc-tiddler-body blockquote {
	margin: 1.3em 0;
	margin-inline-start: 0;
	padding: 0.3em 0 0.3em 1.1em;
	border-inline-start: 2px solid var(--n-line-strong);
	background: none;
	border-radius: 0;
	color: var(--n-muted);
}

/* Rule — a hard line, not a fade. Chiaroscuro does not do soft edges. */
.tc-tiddler-body hr {
	border: none;
	height: 1px;
	margin: 2em 0;
	background: var(--n-line-strong);
}

/* Code sits INTO the stage — recessed, the one place a surface goes deeper */
.tc-tiddler-body code {
	font-family: var(--n-mono);
	font-size: 0.86em;
	padding: 0.12em 0.4em;
	border-radius: var(--n-radius);
	border: 1px solid var(--n-line);
	background: var(--n-recessed);
}
.tc-tiddler-body pre {
	border-radius: var(--n-radius);
	border: 1px solid var(--n-line);
	background: var(--n-recessed);
	box-shadow: none;
}
.tc-tiddler-body pre code { border: none; background: none; padding: 0; }

/* Tables — a recessed header and hairline cells. The four corner-radius rules
   and the `border-collapse: separate` they required are gone with the radius. */
.tc-tiddler-body table {
	border-collapse: collapse;
	border: 1px solid var(--n-line-strong);
	border-radius: 0;
	font-variant-numeric: tabular-nums;
}
.tc-tiddler-body table th {
	background: var(--n-recessed);
	font-family: var(--n-body);
	font-weight: 600;
	text-align: start;
	border: 1px solid var(--n-line);
	border-bottom: 1px solid var(--n-line-strong);
}
.tc-tiddler-body table td { border: 1px solid var(--n-line); }
.tc-tiddler-body table th, .tc-tiddler-body table td { overflow-wrap: anywhere; }
.tc-tiddler-body table tr:hover td { background: var(--n-hover); }

/* Images sit on the stage, not above it */
.tc-tiddler-body img {
	border-radius: var(--n-radius);
	border: 1px solid var(--n-line);
	box-shadow: none;
}

.tc-tiddler-body strong { font-weight: 700; }
.tc-tiddler-body small { color: var(--n-muted); }

/* Fold / unfold banners — vanilla positions both with negative margins sized to
   its own 42px frame padding, which is not our padding. Re-anchor them to the
   stage edge with left/right. Desktop only: on mobile vanilla lays the unfold
   banner out statically, and forcing it absolute there would strand it. */
@media (min-width: 770px) {
	.tc-unfold-banner.tc-unfold-banner {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		width: auto;
		-webkit-margin-start: 0;
		margin-inline-start: 0;
		border-radius: 0;
	}
	.tc-fold-banner.tc-fold-banner {
		inset-inline-start: 0;
		top: 0;
		bottom: 0;
		max-width: var(--n-frame-pad-x);
		-webkit-margin-start: 0;
		margin-inline-start: 0;
		border-radius: 0;
	}
}
