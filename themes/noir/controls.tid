title: $:/themes/tiddlywiki/noir/controls
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** Buttons, tags, controls, overlays, inputs & sidebar
**
** Hover is a step of LIGHT, not a wash of colour and never a movement. That
** follows the same rule the stage does: this theme has one depth system, so
** the way anything says "I am active" is by being lit a little more.
**
** Nothing is frosted — the atmospheric register bans glass outright, and the
** blur was sitting on top of a perfectly good layered-surface system anyway.
*/

/* The genre asks for fade only: no slide, no bounce. The rise used to
   translate 8px on every dropdown, modal and info panel. */
@keyframes n-fade {
	from { opacity: 0; }
	to   { opacity: 1; }
}

/* Toolbar icons — the glyph warms; nothing scales. */
.tc-tiddler-controls button,
.tc-page-controls button,
.tc-topbar button {
	border-radius: var(--n-radius);
	transition: background-color var(--n-dur) var(--n-ease);
}
.tc-tiddler-controls button svg,
.tc-page-controls button svg,
.tc-topbar button svg { transition: fill var(--n-dur) var(--n-ease); }
.tc-tiddler-controls button:hover,
.tc-page-controls button:hover,
.tc-topbar button:hover { background: var(--n-hover); }
.tc-tiddler-controls button:hover svg,
.tc-page-controls button:hover svg,
.tc-topbar button:hover svg { fill: var(--n-accent-bright); }

/* Standard buttons — a recessed surface that lights up */
button.tc-btn-standard,
.tc-btn-boxed,
.tc-btn-rounded {
	font-family: var(--n-body);
	border-radius: var(--n-radius);
	border: 1px solid var(--n-line-strong);
	background: var(--n-recessed);
	transition: border-color var(--n-dur) var(--n-ease),
		background-color var(--n-dur) var(--n-ease),
		color var(--n-dur) var(--n-ease);
}
/* One signal: the surface takes a step of light and its edge follows. The
   label colour stays put — three properties moving at once on a hover is a
   pile-up, and this theme's whole argument is that light alone is enough. */
button.tc-btn-standard:hover,
.tc-btn-boxed:hover,
.tc-btn-rounded:hover {
	border-color: var(--n-accent);
	background: var(--n-hover);
}
button.tc-btn-standard:active,
.tc-btn-boxed:active,
.tc-btn-rounded:active { background: var(--n-select); }

/*
** Primary — a solid block of accent. It used to fire three simultaneous hover
** effects (fill swap + halo shadow + translateY) and its hover fill measured
** 2.63:1 against its own label on the light palette.
*/
.tc-btn-big-green,
.tc-primary-btn,
button.tc-btn-big-green {
	font-family: var(--n-body);
	background: var(--n-accent-ink) !important;
	color: <<colour background>> !important;
	border: 1px solid var(--n-accent-ink) !important;
	border-radius: var(--n-radius);
	box-shadow: none;
	transition: background-color var(--n-dur) var(--n-ease),
		border-color var(--n-dur) var(--n-ease);
}
.tc-btn-big-green svg, .tc-primary-btn svg { fill: <<colour background>> !important; }
.tc-btn-big-green:hover, .tc-primary-btn:hover {
	background: var(--n-accent-bright) !important;
	border-color: var(--n-accent-bright) !important;
}
.tc-btn-big-green:active, .tc-primary-btn:active {
	background: var(--n-accent) !important;
	border-color: var(--n-accent) !important;
}

/* Disabled — three channels, never opacity alone */
button:disabled,
button[aria-disabled="true"],
input:disabled,
textarea:disabled,
select:disabled {
	opacity: 0.55;
	cursor: not-allowed;
	border-color: var(--n-line);
}
button:disabled:hover,
button[aria-disabled="true"]:hover {
	background: var(--n-recessed);
	border-color: var(--n-line);
	color: inherit;
}

/* Tags — flat labels with a hard edge. They used to glow, and glow on hover.
   TiddlyWiki sets the tag's text colour INLINE (contrastcolour vs the palette's
   default tag-background). Since we restyle the background, we must override
   that inline colour with !important so text always contrasts with OUR chip.
   The background stays non-important so user-coloured tags keep their fill. */
.tc-tag-label.tc-tag-label:not([style*="background-color"]),
.tc-tag-label.tc-tag-label[style*="background-color:;"],
.tc-tag-label.tc-tag-label[style*="background-color: ;"] {
	background-color: transparent;
	color: <<colour foreground>> !important;
	fill: <<colour foreground>> !important;
	box-shadow: inset 0 0 0 1px var(--n-line-strong);
}
.tc-tag-label.tc-tag-label:not([style*="background-color"]):hover,
.tc-tag-label.tc-tag-label[style*="background-color:;"]:hover,
.tc-tag-label.tc-tag-label[style*="background-color: ;"]:hover {
	background-color: var(--n-hover);
	box-shadow: inset 0 0 0 1px var(--n-accent);
}
.tc-tag-label.tc-tag-label:not([style*="background-color"]) svg,
.tc-tag-label.tc-tag-label[style*="background-color:;"] svg,
.tc-tag-label.tc-tag-label[style*="background-color: ;"] svg { fill: <<colour foreground>> !important; }

/* Themed shape + a subtle defining edge on every tag. Coloured tags
   (#hex, rgb(), or a named colour like GreenYellow) keep their own fill
   and contrastcolour text and gain this edge; the uncoloured chip above
   overrides the box-shadow with its own. */
.tc-tag-label.tc-tag-label {
	font-family: var(--n-body);
	font-size: 0.82em;
	border-radius: var(--n-radius);
	box-shadow: inset 0 0 0 1px var(--n-line-strong);
	transition: box-shadow var(--n-dur) var(--n-ease),
		background-color var(--n-dur) var(--n-ease);
}

.tc-untagged-label { border-radius: var(--n-radius); }

/* Dropdowns — opaque, and the ONE place a shadow is earned: this genuinely
   floats above the page and has to occlude it. */
.tc-drop-down,
.tc-block-dropdown {
	font-family: var(--n-body);
	border-radius: var(--n-radius);
	border: 1px solid var(--n-line-strong);
	background: <<colour dropdown-background>>;
	box-shadow: var(--n-lift);
	padding: var(--n-space-3xs);
	animation: n-fade var(--n-dur) var(--n-ease) both;
}
.tc-drop-down a.tc-tiddlylink,
.tc-drop-down button,
.tc-drop-down .tc-dropdown-item,
.tc-block-dropdown a.tc-tiddlylink {
	border-radius: var(--n-radius);
	transition: background-color var(--n-fast) var(--n-ease);
}
/* Contrast-safe hover: vanilla pairs a primary background with near-white text;
   since we replace the background with a light step, restore a contrasting ink. */
.tc-drop-down a:hover,
.tc-drop-down button:hover,
.tc-drop-down .tc-btn-invisible:hover,
.tc-drop-down .tc-file-input-wrapper:hover button,
.tc-block-dropdown a:hover,
.tc-block-tags-dropdown .tc-btn-invisible:hover {
	background: var(--n-hover);
	color: var(--n-ink);
}
.tc-drop-down button.tc-btn-invisible:hover svg,
.tc-block-dropdown button.tc-btn-invisible:hover svg,
.tc-block-tags-dropdown .tc-btn-invisible:hover svg { fill: var(--n-ink); }
.tc-drop-down .tc-tab-divider, .tc-drop-down hr { border: none; height: 1px; background: var(--n-line); }

/* Modals */
.tc-modal {
	border-radius: var(--n-radius);
	border: 1px solid var(--n-line-strong);
	background: <<colour modal-background>>;
	box-shadow: var(--n-lift-high);
	overflow: hidden;
	animation: n-fade var(--n-slow) var(--n-ease) both;
}
.tc-modal-header { border-bottom: 1px solid var(--n-line); }
.tc-modal-footer { border-top: 1px solid var(--n-line); background: var(--n-recessed); }

.tc-notification {
	border-radius: var(--n-radius);
	border: 1px solid var(--n-line-strong);
	background: <<colour notification-background>>;
	box-shadow: var(--n-lift);
	animation: n-fade var(--n-dur) var(--n-ease) both;
}
.tc-alert { border-radius: var(--n-radius); box-shadow: var(--n-lift); }

/* Info panel — inline content, so it recesses rather than floats, and arrives
   without an animation. Full-bleed to the stage edges via the gutter variable. */
.tc-tiddler-info {
	margin-inline: calc(var(--n-frame-pad-x, 0px) * -1);
	padding-inline: var(--n-frame-pad-x, 0px);
	border-radius: 0;
	border: none;
	border-top: 1px solid var(--n-line);
	border-bottom: 1px solid var(--n-line);
	background: var(--n-recessed);
}

/*
** Inputs — a field set into the stage.
**
** The border shift is decoration and may transition. The focus RING is the
** accessibility indicator and must not: it comes from the `:focus-visible`
** outline in variables.tid, which is never transitioned. These rules
** deliberately do NOT set `outline: none` — an attribute selector plus
** `:focus` outranks the zero-specificity `:where(...):focus-visible` base rule,
** so suppressing the outline here would leave keyboard users with a ring that
** fades in, which is to say with no ring at the moment they need one.
*/
input[type="text"],
input[type="search"],
input.tc-edit-texteditor,
textarea.tc-edit-texteditor,
.tc-edit-texteditor,
select {
	border-radius: var(--n-radius);
	background: var(--n-recessed);
	transition: border-color var(--n-dur) var(--n-ease);
}
input[type="text"]:focus,
input[type="search"]:focus,
input.tc-edit-texteditor:focus,
textarea.tc-edit-texteditor:focus,
.tc-edit-texteditor:focus {
	border-color: var(--n-accent);
}
.tc-edit-tags { border-radius: var(--n-radius); }

/* Tabs — a hard accent line under the chosen one */
.tc-tab-buttons button {
	font-family: var(--n-body);
	border-radius: var(--n-radius) var(--n-radius) 0 0;
	transition: color var(--n-dur) var(--n-ease), background-color var(--n-dur) var(--n-ease);
}
.tc-tab-buttons button:hover { background: var(--n-hover); }
.tc-tab-buttons button.tc-tab-selected {
	color: <<colour foreground>>;
	box-shadow: inset 0 -2px 0 var(--n-accent);
}

.tc-plugin-info {
	border-radius: var(--n-radius);
	border-color: var(--n-line-strong);
	box-shadow: none;
	transition: border-color var(--n-dur) var(--n-ease),
		background-color var(--n-dur) var(--n-ease);
}
/* Override vanilla's flood-fill hover (0,3,1) with Noir's step of light. */
a.tc-tiddlylink.tc-plugin-info:hover {
	background-color: var(--n-hover);
	color: <<colour foreground>>;
	fill: var(--n-accent-bright);
	border-color: var(--n-accent);
	box-shadow: none;
	text-decoration: none;
}
a.tc-tiddlylink.tc-plugin-info:hover > .tc-plugin-info-chunk > svg {
	fill: var(--n-accent-bright);
}
a.tc-tiddlylink.tc-plugin-info:hover > .tc-plugin-info-chunk .tc-plugin-info-stability {
	color: <<colour foreground>>;
	border-color: var(--n-line-strong);
}

/*
** Sidebar
*/
.tc-site-title {
	font-family: var(--n-display);
	font-style: normal;
	font-weight: 600;
	letter-spacing: -0.032em;
	font-size: clamp(1.5rem, 1.25rem + 1vw, 1.95rem);
	color: <<colour site-title-foreground>>;
	text-shadow: none;
	overflow-wrap: anywhere;
	min-width: 0;
}
/* Masthead underline — a hard accent line that stops short, like a light cut
   off by a flag. It used to be a gradient band running an `n-pulse` loop every
   five seconds forever, with `will-change: opacity` pinned to it. */
.tc-site-title::after {
	content: "";
	display: block;
	height: 2px;
	width: 2.5rem;
	margin-top: 0.55rem;
	background: var(--n-accent);
}
.tc-site-subtitle {
	font-family: var(--n-mono);
	font-size: 0.76rem;
	color: var(--n-faint);
}

.tc-sidebar-lists .tc-tab-buttons button {
	font-family: var(--n-body);
	transition: color var(--n-dur) var(--n-ease);
}
.tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected {
	color: <<colour foreground>>;
	box-shadow: inset 0 -2px 0 var(--n-accent);
}
/* Colour only — the 2px glide made every sidebar list twitch under the pointer */
.tc-sidebar-lists a.tc-tiddlylink {
	border-radius: var(--n-radius);
	transition: color var(--n-dur) var(--n-ease);
}
.tc-sidebar-lists a.tc-tiddlylink:hover { color: var(--n-accent-bright); }
.tc-sidebar-tab-open-item {
	border-radius: var(--n-radius);
	transition: background-color var(--n-fast) var(--n-ease);
}
.tc-sidebar-tab-open-item:hover { background: var(--n-hover); }

.tc-sidebar-header .tc-search input,
.tc-search input {
	font-family: var(--n-body);
	border-radius: var(--n-radius);
	border: 1px solid var(--n-line-strong);
	background: var(--n-recessed);
	transition: border-color var(--n-dur) var(--n-ease);
}
.tc-sidebar-header .tc-search input:focus,
.tc-search input:focus { border-color: var(--n-accent); }

.tc-page-controls { gap: var(--n-space-3xs); }
