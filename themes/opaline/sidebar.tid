title: $:/themes/tiddlywiki/opaline/sidebar
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** Sidebar
*/

.tc-sidebar-header { padding-top: var(--o-space-2xs); }

/*
** Masthead — the one place fire appears without being a state, and the reason
** it is allowed: this is the stone itself. A SHORT segment of play-of-colour
** sits at the head of a plain hairline, off to one side, the way fire sits in
** one part of an opal rather than across all of it. Static.
**
** It used to be a full-width iridescent band running an `o-sheen` loop every
** eight seconds, forever, with `will-change: background-position` pinned to it.
*/
.tc-site-title {
	font-size: clamp(1.6rem, 1.3rem + 1vw, 2.05rem);
	font-weight: 600;
	letter-spacing: -0.021em;
	color: <<colour site-title-foreground>>;
}
.tc-site-title::after {
	content: "";
	display: block;
	height: 2px;
	width: 100%;
	margin-top: 0.55rem;
	background-color: var(--o-rule);
	background-image: var(--o-fire);
	background-repeat: no-repeat;
	background-size: 28% 100%;
	background-position: left center;
}

.tc-site-subtitle {
	font-family: var(--o-body);
	font-size: 0.8rem;
	letter-spacing: 0.02em;
	color: var(--o-faint);
}

/* Sidebar tabs — the same fire underline the story tabs use, for the same
   reason: it marks the one that is selected. */
.tc-sidebar-lists .tc-tab-buttons button {
	font-family: var(--o-body);
	border-radius: var(--o-radius-sm) var(--o-radius-sm) 0 0;
	transition: color var(--o-dur) var(--o-ease);
}
.tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected {
	position: relative;
	color: <<colour foreground>>;
	font-weight: 600;
}
.tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected::after {
	content: "";
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 2px;
	background: var(--o-fire);
}

/* Sidebar links: colour only. The 2px glide on hover made every list in the
   sidebar twitch under the pointer, which is motion with nothing to say. */
.tc-sidebar-lists a.tc-tiddlylink,
.tc-sidebar-lists .tc-tiddlylink {
	border-radius: var(--o-radius-sm);
	transition: color var(--o-dur) var(--o-ease);
}
.tc-sidebar-lists a.tc-tiddlylink:hover {
	color: var(--o-accent-ink);
}

/* Search: a machined field that takes a fire edge on focus. The ring itself is
   the instant `:focus-visible` outline from variables.tid, so no `outline: none`
   and no transitioned box-shadow standing in for it. */
.tc-sidebar-header .tc-search input,
.tc-search input {
	font-family: var(--o-body);
	border-radius: var(--o-radius-sm);
	border: 1px solid var(--o-rule);
	background: var(--o-tint);
	transition: border-color var(--o-dur) var(--o-ease),
		background-color var(--o-dur) var(--o-ease);
}
.tc-sidebar-header .tc-search input:focus,
.tc-search input:focus {
	border-color: var(--o-fire-a);
	background: <<colour background>>;
}

.tc-sidebar-tab-open-item {
	border-radius: var(--o-radius-sm);
	transition: background-color var(--o-fast) var(--o-ease);
}
.tc-sidebar-tab-open-item:hover { background: var(--o-tint); }

.tc-sidebar-lists .tc-tab-set .tc-tab-divider {
	border: none;
	height: 1px;
	background: var(--o-rule);
}

.tc-page-controls { gap: var(--o-space-3xs); }
