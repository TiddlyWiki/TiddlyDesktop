title: $:/themes/tiddlywiki/opaline/controls
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** Buttons, tags, controls, inputs, dropdowns & modals
**
** Nothing here is frosted. Every surface that floats is opaque, which is not
** only a style call: the semi-transparent glass is what forced two separate
** workarounds out of this theme. A blurred panel becomes a "backdrop root",
** so the more-tiddler-actions popup nested inside a frosted sticky title had
** nothing left to sample and rendered as a bare translucent rectangle. With
** opaque surfaces the bug cannot occur, and both workarounds are gone.
**
** Fire appears on exactly three things, all of them ACTIVE states: the
** selected tab, the focused field, and the panel being edited. Nowhere else.
*/

@keyframes o-rise {
	from { opacity: 0; transform: translate3d(0, 6px, 0); }
	to   { opacity: 1; transform: translate3d(0, 0, 0); }
}

/* Toolbar icons: one signal — the glyph changes colour. No scale: a toolbar
   that flinches when the pointer crosses it is noise, and a row of them
   flinching is a nervous tic. */
.tc-tiddler-controls button,
.tc-page-controls button,
.tc-topbar button {
	border-radius: var(--o-radius-sm);
	transition: background-color var(--o-dur) var(--o-ease);
}
.tc-tiddler-controls button svg,
.tc-page-controls button svg,
.tc-topbar button svg {
	transition: fill var(--o-dur) var(--o-ease);
}
.tc-tiddler-controls button:hover,
.tc-page-controls button:hover,
.tc-topbar button:hover {
	background: var(--o-tint);
}
.tc-tiddler-controls button:hover svg,
.tc-page-controls button:hover svg,
.tc-topbar button:hover svg {
	fill: var(--o-accent-ink);
}

/* Standard buttons: a machined hairline box. The hover moves the edge and the
   label together, once. */
button.tc-btn-standard,
.tc-btn-boxed,
.tc-btn-rounded {
	font-family: var(--o-body);
	border-radius: var(--o-radius-sm);
	border: 1px solid var(--o-rule-strong);
	transition: border-color var(--o-dur) var(--o-ease),
		color var(--o-dur) var(--o-ease);
}
button.tc-btn-standard:hover,
.tc-btn-boxed:hover,
.tc-btn-rounded:hover {
	border-color: var(--o-accent-ink);
	color: var(--o-accent-ink);
}
/* Press feedback in colour rather than in movement — the confirmation a button
   owes you, without reintroducing the transform this theme just removed. */
button.tc-btn-standard:active,
.tc-btn-boxed:active,
.tc-btn-rounded:active {
	background: var(--o-wash-strong);
}

/*
** Primary / call-to-action: one solid block of accent.
**
** This used to be filled with the six-stop iris gradient and animated its
** background-position on hover, while also lifting and deepening its shadow —
** three simultaneous hover effects. Worse, the label is `<<colour background>>`,
** which on the light palette put white text on that gradient at 3.23:1 over the
** blue stop and 1.97:1 over the teal one: the Save button failed contrast
** across its entire fill. `--o-cta` bends the primary toward the palette
** foreground until the label clears 4.5:1 in both palettes.
*/
.tc-btn-big-green,
.tc-primary-btn,
button.tc-btn-big-green {
	font-family: var(--o-body);
	background: var(--o-cta) !important;
	color: <<colour background>> !important;
	border: 1px solid var(--o-cta) !important;
	border-radius: var(--o-radius-sm);
	box-shadow: none;
	transition: background-color var(--o-dur) var(--o-ease),
		border-color var(--o-dur) var(--o-ease);
}
.tc-btn-big-green svg,
.tc-primary-btn svg { fill: <<colour background>> !important; }
.tc-btn-big-green:hover,
.tc-primary-btn:hover {
	background: var(--o-accent-ink) !important;
	border-color: var(--o-accent-ink) !important;
}
.tc-btn-big-green:active,
.tc-primary-btn:active {
	background: var(--o-fire-a) !important;
	border-color: var(--o-fire-a) !important;
}

/* Tags: flat machined labels — a hairline box, no fill, no lift.
   TiddlyWiki sets the tag's text colour INLINE (contrastcolour vs the palette's
   default tag-background). Since we restyle the background, we must override that
   inline colour with !important so text always contrasts with OUR chip. The
   background stays non-important so user-coloured tags keep their own fill. */
.tc-tag-label.tc-tag-label:not([style*="background-color"]),
.tc-tag-label.tc-tag-label[style*="background-color:;"],
.tc-tag-label.tc-tag-label[style*="background-color: ;"] {
	background-color: transparent;
	color: <<colour foreground>> !important;
	fill: <<colour foreground>> !important;
	box-shadow: inset 0 0 0 1px var(--o-rule-strong);
}
.tc-tag-label.tc-tag-label:not([style*="background-color"]):hover,
.tc-tag-label.tc-tag-label[style*="background-color:;"]:hover,
.tc-tag-label.tc-tag-label[style*="background-color: ;"]:hover {
	background-color: var(--o-tint);
	box-shadow: inset 0 0 0 1px var(--o-accent-ink);
}
.tc-tag-label.tc-tag-label:not([style*="background-color"]) svg,
.tc-tag-label.tc-tag-label[style*="background-color:;"] svg,
.tc-tag-label.tc-tag-label[style*="background-color: ;"] svg { fill: <<colour foreground>> !important; }

/* Themed shape + a subtle defining edge on every tag. Coloured tags
   (#hex, rgb(), or a named colour like GreenYellow) keep their own fill
   and contrastcolour text and gain this edge; the uncoloured chip above
   overrides the box-shadow with its hairline. */
.tc-tag-label.tc-tag-label {
	font-family: var(--o-body);
	font-size: 0.8em;
	border-radius: var(--o-radius-sm);
	box-shadow: inset 0 0 0 1px var(--o-rule-strong);
	transition: box-shadow var(--o-dur) var(--o-ease),
		background-color var(--o-dur) var(--o-ease);
}

.tc-untagged-label { border-radius: var(--o-radius-sm); }

/* Dropdowns: an opaque panel genuinely lifted off the page */
.tc-drop-down,
.tc-block-dropdown {
	font-family: var(--o-body);
	border-radius: var(--o-radius);
	border: 1px solid var(--o-rule-strong);
	background: <<colour dropdown-background>>;
	box-shadow: var(--o-lift);
	padding: var(--o-space-3xs);
	animation: o-rise var(--o-dur) var(--o-ease) both;
}
.tc-drop-down a.tc-tiddlylink,
.tc-drop-down button,
.tc-drop-down .tc-dropdown-item,
.tc-block-dropdown a.tc-tiddlylink {
	border-radius: var(--o-radius-sm);
	transition: background-color var(--o-fast) var(--o-ease);
}
/* Hover rows: vanilla pairs a primary background with near-white text; since we
   replace the background with a light wash, we must restore a dark, contrasting
   foreground (and icon fill) so the text never sits white-on-pale. */
.tc-drop-down a:hover,
.tc-drop-down button:hover,
.tc-drop-down .tc-btn-invisible:hover,
.tc-drop-down .tc-file-input-wrapper:hover button,
.tc-block-dropdown a:hover,
.tc-block-tags-dropdown .tc-btn-invisible:hover {
	background: var(--o-wash-strong);
	color: var(--o-ink);
}
.tc-drop-down button.tc-btn-invisible:hover svg,
.tc-block-dropdown button.tc-btn-invisible:hover svg,
.tc-block-tags-dropdown .tc-btn-invisible:hover svg {
	fill: var(--o-ink);
}
.tc-drop-down .tc-tab-divider,
.tc-drop-down hr { border: none; height: 1px; background: var(--o-rule); }

/* Modals: opaque, hairline-framed, genuinely raised */
.tc-modal {
	border-radius: var(--o-radius);
	border: 1px solid var(--o-rule-strong);
	background: <<colour modal-background>>;
	box-shadow: var(--o-lift-high);
	overflow: hidden;
	animation: o-rise var(--o-slow) var(--o-ease) both;
}
.tc-modal-header { border-bottom: 1px solid var(--o-rule); }
.tc-modal-footer { border-top: 1px solid var(--o-rule); background: var(--o-tint); }

/* Notifications & alerts */
.tc-notification {
	border-radius: var(--o-radius);
	border: 1px solid var(--o-rule-strong);
	background: <<colour notification-background>>;
	box-shadow: var(--o-lift);
	animation: o-rise var(--o-dur) var(--o-ease) both;
}
.tc-alert { border-radius: var(--o-radius); box-shadow: var(--o-lift); }

/* Tiddler info panel — inline content, not a floating surface, so it gets rules
   rather than a raised box and arrives without an animation. Full-bleed to the
   panel edges via the gutter variable, then re-padded so its text lines up. */
.tc-tiddler-info {
	margin-inline: calc(var(--o-frame-pad-x, 0px) * -1);
	padding-inline: var(--o-frame-pad-x, 0px);
	border-radius: 0;
	border: none;
	border-top: 1px solid var(--o-rule);
	border-bottom: 1px solid var(--o-rule);
	background: var(--o-tint);
}

/*
** Inputs — the second place fire is allowed, because focus is a state.
**
** The border-colour shift is decoration and may transition. The focus RING is
** the accessibility indicator and must not: it comes from the `:focus-visible`
** outline in variables.tid, which is never transitioned and so is on screen the
** instant the field is reached. These rules deliberately do NOT set
** `outline: none` — an attribute selector plus `:focus` outranks the
** zero-specificity `:where(...):focus-visible` base rule, so suppressing the
** outline here would leave keyboard users with a ring that fades in over 220ms,
** which is to say with no ring at the moment they need one.
*/
input[type="text"],
input[type="search"],
input.tc-edit-texteditor,
textarea.tc-edit-texteditor,
.tc-edit-texteditor,
select {
	border-radius: var(--o-radius-sm);
	transition: border-color var(--o-dur) var(--o-ease);
}
input[type="text"]:focus,
input[type="search"]:focus,
input.tc-edit-texteditor:focus,
textarea.tc-edit-texteditor:focus,
.tc-edit-texteditor:focus {
	border-color: var(--o-fire-a);
}
.tc-edit-tags { border-radius: var(--o-radius-sm); }

/* Disabled controls: three channels, never opacity alone */
button:disabled,
button[aria-disabled="true"],
input:disabled,
textarea:disabled,
select:disabled {
	opacity: 0.55;
	cursor: not-allowed;
	border-color: var(--o-rule);
}
button:disabled:hover,
button[aria-disabled="true"]:hover {
	background: none;
	border-color: var(--o-rule);
	color: inherit;
}

/*
** Tabs — the third and last place fire appears. A 2px band of play-of-colour
** under the selected tab, drawn once and left alone. It used to run an
** `o-sheen` loop across it every 6 seconds forever; a decoration that never
** finishes pulls the eye and tells the reader nothing.
*/
.tc-tab-buttons button {
	font-family: var(--o-body);
	border-radius: var(--o-radius-sm) var(--o-radius-sm) 0 0;
	transition: color var(--o-dur) var(--o-ease);
}
.tc-tab-buttons button:hover { color: var(--o-accent-ink); }
.tc-tab-buttons button.tc-tab-selected {
	position: relative;
	color: <<colour foreground>>;
	font-weight: 600;
}
.tc-tab-buttons button.tc-tab-selected::after {
	content: "";
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 2px;
	background: var(--o-fire);
}

/* Plugin chips */
.tc-plugin-info {
	border-radius: var(--o-radius);
	border-color: var(--o-rule-strong);
	box-shadow: none;
	transition: border-color var(--o-dur) var(--o-ease);
}
/* Override vanilla's flood-fill hover (0,3,1) with Opaline's hairline shift. */
a.tc-tiddlylink.tc-plugin-info:hover {
	background-color: <<colour tiddler-background>>;
	color: <<colour foreground>>;
	fill: var(--o-accent-ink);
	border-color: var(--o-accent-ink);
	box-shadow: none;
	text-decoration: none;
}
a.tc-tiddlylink.tc-plugin-info:hover > .tc-plugin-info-chunk > svg {
	fill: var(--o-accent-ink);
}
a.tc-tiddlylink.tc-plugin-info:hover > .tc-plugin-info-chunk .tc-plugin-info-stability {
	color: <<colour foreground>>;
	border-color: <<colour tiddler-border>>;
}
