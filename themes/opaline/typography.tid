title: $:/themes/tiddlywiki/opaline/typography
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** Typography — luminous humanist, set tight
**
** The display face is chosen for its optics: Optima (and its Candara /
** Cantarell stand-ins) has subtly flared stems that catch light along their
** length. That is the theme's argument in a typeface, so it does the titles.
** The body face is a plain reading sans and stays out of the way.
*/

.tc-tiddler-body {
	font-family: var(--o-body);
	font-size: clamp(1rem, 0.97rem + 0.18vw, 1.1rem);
	line-height: 1.65;
	color: var(--o-ink);
	font-feature-settings: "kern" 1, "liga" 1, "calt" 1;
	text-wrap: pretty;
}

.tc-tiddler-body p { margin: 0 0 1.05em 0; }

/* Titles & headings — tightly tracked, which is what keeps a humanist face
   reading as engineered rather than as calligraphic. */
.tc-titlebar h2,
.tc-site-title,
.tc-tiddler-body h1,
.tc-tiddler-body h2,
.tc-tiddler-body h3,
.tc-tiddler-body h4,
.tc-tiddler-body h5,
.tc-tiddler-body h6 {
	font-family: var(--o-display);
	font-style: normal;
	line-height: 1.2;
	text-wrap: balance;
	/* Tiddler titles are routinely long unbroken strings — system paths like
	   $:/themes/tiddlywiki/opaline/variables have no space to break at. The
	   inherited `word-wrap: break-word` breaks the line but still reports the
	   whole word as the min-content width, so in a flex titlebar it can push
	   the row wide. `anywhere` + `min-width: 0` makes the break count. */
	overflow-wrap: anywhere;
	min-width: 0;
}

/* The panel title — large enough that size carries it, so 600 not 700 */
.tc-titlebar h2 {
	font-size: clamp(1.7rem, 1.45rem + 1.2vw, 2.35rem);
	font-weight: 600;
	letter-spacing: -0.021em;
}

/* Body headings have no room for size, so they take the contrast in weight:
   700 against a 400 body. */
.tc-tiddler-body h1,
.tc-tiddler-body h2,
.tc-tiddler-body h3,
.tc-tiddler-body h4 {
	font-weight: 700;
	letter-spacing: -0.014em;
}
.tc-tiddler-body h1 { font-size: 1.8em; margin: 1.5em 0 0.5em; }
.tc-tiddler-body h2 { font-size: 1.44em; margin: 1.4em 0 0.45em; }
.tc-tiddler-body h3 { font-size: 1.18em; margin: 1.25em 0 0.4em; }
.tc-tiddler-body h4 { font-size: 1.02em; margin: 1.15em 0 0.35em; letter-spacing: -0.006em; }

/* The lowest two levels leave the size ladder and become tracked-out labels */
.tc-tiddler-body h5,
.tc-tiddler-body h6 {
	font-family: var(--o-body);
	font-weight: 600;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	font-size: 0.78em;
	color: var(--o-muted);
	margin: 1.2em 0 0.35em;
}

/* Links: one signal. The ink stays put; only the rule beneath it comes up to
   full strength, so nothing shifts and nothing flashes. */
.tc-tiddler-body a.tc-tiddlylink,
.tc-tiddler-body a.tc-tiddlylink-resolves {
	color: var(--o-accent-ink);
	text-decoration: underline;
	text-decoration-thickness: 1px;
	text-decoration-color: var(--o-rule-strong);
	text-underline-offset: 0.16em;
	transition: text-decoration-color var(--o-dur) var(--o-ease);
}
/* `:not(.tc-plugin-info)` keeps us clear of plugin boxes, whose vanilla hover is
   white text on a primary fill — recolouring it to the accent kills contrast. */
.tc-tiddler-body a.tc-tiddlylink:not(.tc-plugin-info):hover {
	text-decoration-color: var(--o-accent-ink);
}
.tc-tiddler-body a.tc-tiddlylink-missing {
	text-decoration-style: dotted;
	opacity: 0.85;
}

/* Lists — markers in the muted ink, not the accent. A bullet is non-text
   content that still has to clear 3:1, and a hairline tint does not. */
.tc-tiddler-body ul, .tc-tiddler-body ol { padding-left: 1.45em; }
.tc-tiddler-body li { margin: 0.28em 0; }
.tc-tiddler-body li::marker { color: var(--o-muted); }

/* Block quote: a plain hairline edge and an italic voice. The old treatment
   stacked a 3px iridescent border-image, an accent wash and a rounded corner
   on a passage of running text — three decorations for one quotation. */
.tc-tiddler-body blockquote {
	margin: 1.4em 0;
	margin-inline-start: 0;
	padding: 0.2em 0 0.2em 1.2em;
	border-inline-start: 1px solid var(--o-rule-strong);
	border-radius: 0;
	background: none;
	color: var(--o-muted);
	font-style: italic;
}

/* Horizontal rule: a single flush hairline. An instrument divides with a line. */
.tc-tiddler-body hr {
	border: none;
	height: 1px;
	margin: 2.2em 0;
	border-radius: 0;
	background: var(--o-rule-strong);
	opacity: 1;
}

/* Code: a milky field, mono face, machined corners */
.tc-tiddler-body code {
	font-family: var(--o-mono);
	font-size: 0.86em;
	padding: 0.12em 0.4em;
	border-radius: var(--o-radius-sm);
	border: 1px solid var(--o-rule);
	background: var(--o-tint);
}
.tc-tiddler-body pre {
	border-radius: var(--o-radius);
	border: 1px solid var(--o-rule);
	box-shadow: none;
}
.tc-tiddler-body pre code { border: none; background: none; padding: 0; }

/*
** Tables: a framed grid — this theme reads a table as an instrument panel, so
** it keeps a full hairline frame rather than the open ruled setting an
** editorial theme would use. Corners come from the frame itself now that the
** radius is small enough not to need per-cell rounding, which retires four
** corner-cell rules and the `overflow: hidden` clipping hazard with them.
*/
.tc-tiddler-body table {
	border-collapse: collapse;
	/* One step lighter than the panel's own edge. A framed table inside a framed
	   panel at the SAME weight reads as card-in-card; making the inner frame
	   subordinate keeps the nesting hierarchical instead of repeated. */
	border: 1px solid var(--o-rule);
	border-radius: var(--o-radius);
	box-shadow: none;
	font-variant-numeric: tabular-nums lining-nums;
}
.tc-tiddler-body table th {
	font-family: var(--o-body);
	font-weight: 600;
	font-size: 0.86em;
	letter-spacing: 0.03em;
	text-align: start;
	background: var(--o-tint);
	border: 1px solid var(--o-rule);
	border-bottom: 1px solid var(--o-rule-strong);
}
.tc-tiddler-body table td { border: 1px solid var(--o-rule); }
.tc-tiddler-body table tr:hover td { background: var(--o-tint); }

/* Images: a hairline mat, flat on the panel */
.tc-tiddler-body img {
	border-radius: var(--o-radius-sm);
	border: 1px solid var(--o-rule);
	box-shadow: none;
}

.tc-tiddler-body strong { font-weight: 700; }
.tc-tiddler-body small { color: var(--o-muted); }
