title: $:/themes/tiddlywiki/opaline/story
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** Story river & tiddler panels
**
** Each tiddler is a discrete panel, precisely registered on a flat field —
** an optical bench, not a drift of cards. The page beneath them carries no
** imagery at all: it used to hold four fixed-attached radial gradients in
** aqua, violet, green and gold across the entire viewport, which is the
** aurora-blob pattern that reads as generated within a glance.
*/

/* The field. Flat, and it stays flat. */
.tc-page-container {
	background-image: none;
}

.tc-story-river {
	padding-top: var(--o-space-lg);
	padding-bottom: var(--o-space-xl);
}

/*
** Tiddler panel.
**
** The story views drive this node with inline transform/opacity and popups are
** anchored through it, so it carries NO transform / filter / will-change and no
** CSS animation of transform or opacity.
**
** At rest the panel is a milky body: flat paper, a hairline edge, no colour and
** no shadow. The top edge is drawn one step LIGHTER than the other three — the
** cheapest honest cue that light arrives from above, and the only "elevation"
** this theme spends on something that is sitting on the page rather than
** floating above it.
*/
.tc-tiddler-frame {
	--o-frame-pad-x: var(--o-space-lg);
	margin-bottom: var(--o-space-lg);
	padding: var(--o-space-md) var(--o-frame-pad-x) var(--o-space-md);
	background: var(--o-paper);
	border: 1px solid var(--o-rule-strong);
	border-top-color: var(--o-rule);
	border-radius: var(--o-radius);
	box-shadow: none;
}

/*
** Edit mode — the one resting state that earns fire. A 2px band of
** play-of-colour along the top edge says "this panel is live" at a glance,
** which is exactly the job decoration has to do to be allowed to stay.
*/
.tc-tiddler-frame.tc-tiddler-edit-frame {
	border-color: var(--o-rule-strong);
	background-image: var(--o-fire);
	background-repeat: no-repeat;
	background-size: 100% 2px;
	background-position: top left;
}

@media (max-width: 769px) {
	.tc-tiddler-frame {
		--o-frame-pad-x: var(--o-space-sm);
		margin-bottom: var(--o-space-md);
		padding: var(--o-space-sm) var(--o-frame-pad-x);
	}
	.tc-story-river {
		padding-top: var(--o-space-md);
		padding-bottom: var(--o-space-lg);
	}
}

/* Title block — ruled off from the body below it, the way a panel header is.
   No hover treatment: a panel is not an interactive element. */
.tc-tiddler-title {
	margin-bottom: var(--o-space-sm);
	padding-bottom: var(--o-space-2xs);
	border-bottom: 1px solid var(--o-rule);
}

.tc-titlebar h2 { color: <<colour tiddler-title-foreground>>; }

/* Metadata — the reading sans, quiet, slightly tracked out */
.tc-tiddler-subtitle {
	font-family: var(--o-body);
	font-size: 0.8rem;
	letter-spacing: 0.02em;
	color: var(--o-faint);
}

.tc-tags-wrapper { margin-top: var(--o-space-3xs); }

/* The prose is bound to a measure even though the panel is not — a work
   surface may be as wide as you like; a line of text may not. */
.tc-tiddler-body {
	margin-top: var(--o-space-sm);
	max-width: var(--o-measure);
}

.tc-tiddler-missing .tc-tiddler-body {
	color: var(--o-muted);
	font-style: italic;
}

/* Fold / unfold banners — vanilla positions both with negative margins sized to
   its own 42px frame padding, which is not our padding. Re-anchor them to the
   panel edge with left/right so they stay correct whatever the gutter is.
   Desktop only: on mobile vanilla lays the unfold banner out statically, and
   forcing it absolute there would strand it. */
@media (min-width: 770px) {
	.tc-unfold-banner.tc-unfold-banner {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		width: auto;
		-webkit-margin-start: 0;
		margin-inline-start: 0;
		border-bottom-left-radius: calc(var(--o-radius) - 1px);
		border-bottom-right-radius: calc(var(--o-radius) - 1px);
	}
	.tc-fold-banner.tc-fold-banner {
		inset-inline-start: 0;
		top: 0;
		bottom: 0;
		max-width: var(--o-frame-pad-x);
		-webkit-margin-start: 0;
		margin-inline-start: 0;
		border-start-start-radius: calc(var(--o-radius) - 1px);
		border-end-start-radius: calc(var(--o-radius) - 1px);
	}
}
