title: $:/themes/tiddlywiki/quietude/tiddlydesktop
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** TiddlyDesktop — Quietude theme
**
** The WikiList follows the same rule as the story river: entries separated by
** whitespace and a soft hairline, no cards, and the row's controls kept quiet
** without ever becoming unreachable.
*/

.td-toolbar {
	box-shadow: none;
	border-bottom: 1px solid var(--q-line);
	font-family: var(--q-sans);
}

/* Wiki-list entries — seamless, separated by a hairline */
.td-wikilist .td-wikilist-item {
	border-radius: var(--q-radius);
	box-shadow: none;
	border-bottom: 1px solid var(--q-line);
	transition: background-color var(--q-dur) var(--q-ease);
}
.td-wikilist .td-wikilist-item:hover {
	background-color: var(--q-tint);
}
.td-wikilist .td-wikilist-item.tc-dragging {
	box-shadow: none;
	background-color: var(--q-tint);
}

.td-wikilist .td-wiki-title {
	font-family: var(--q-sans);
	font-weight: 650;
	letter-spacing: -0.012em;
	overflow-wrap: anywhere;
	min-width: 0;
}
.td-wikilist .td-wikilist-info { font-family: var(--q-sans); }
.td-wikilist .td-wiki-url {
	font-family: var(--q-mono);
	font-size: 0.8em;
	color: var(--q-faint);
	overflow-wrap: anywhere;
	min-width: 0;
}

button.td-button {
	border-radius: var(--q-radius-sm);
	font-family: var(--q-sans);
	font-size: 0.84em;
	transition: background-color var(--q-dur) var(--q-ease);
}

.td-toolbar input,
.td-toolbar select {
	font-family: var(--q-sans);
	border-radius: var(--q-radius-sm);
	border: 1px solid var(--q-line);
}

/* ── The WikiList window ─────────────────────────────────────────────── */
.td-search input.td-wikilist-search-input {
	font-family: var(--q-sans);
	border-radius: var(--q-radius-sm);
	border: 1px solid var(--q-line);
	transition: border-color var(--q-dur) var(--q-ease);
}
.td-search input.td-wikilist-search-input:focus {
	border-color: var(--q-accent);
}
.td-tags .tc-tag-label { font-family: var(--q-sans); }

.td-wikilist .td-wikilist-item .td-wikilist-thumbnail button {
	border-radius: var(--q-radius-sm);
	border: 1px solid var(--q-line);
	box-shadow: none;
}
.td-wikilist .td-wikilist-item .td-wiki-toolbar {
	border-top: 1px solid var(--q-line);
	padding-top: var(--q-space-2xs);
}
.td-wikilist .td-wiki-advanced-heading {
	font-family: var(--q-sans);
	font-weight: 600;
}
