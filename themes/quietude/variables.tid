/* Hallmark · genre: editorial · macrostructure: Letter · theme: Quietude
 * mood: soft (calm, unhurried) · anchor hue: sage (chromatic-other)
 * nav: n/a · footer: n/a — TiddlyWiki owns the chrome; a theme has neither.
 * pre-emit critique: P5 H5 E5 S5 R5 V4
 */

/*
** Quietude — design tokens
**
** A distraction-free theme for reading and writing. The page reads as a letter:
** one bounded column, separated by whitespace rather than by frames, with the
** interface kept at the margins.
**
** The chrome still recedes — that is the whole idea — but it recedes by INK,
** not by opacity. The toolbar used to sit at `opacity: 0.12`, which measured
** 1.25:1 against paper: not a whisper, invisible. Worse, it only came back on
** :hover, and a touch device has no hover, so on a tablet the edit and close
** buttons were permanently ghosted with no way to summon them. Recession is now
** a muted ink that always clears contrast, and the recession itself is gated
** behind `(hover: hover) and (pointer: fine)` so coarse pointers get full chrome.
**
** Everything derives from the active palette via <<colour>> and color-mix(),
** mixed in OKLAB. Motion is a fade and nothing else.
*/

:root {
	--q-ink: <<colour foreground>>;
	--q-paper: <<colour tiddler-background>>;

	/* Two DISTINCT secondary inks — they used to be 52% and 50%, which is the
	   same token twice, and both failed on the light palette (3.17:1 and
	   3.00:1, the latter carrying the 0.82rem subtitle). */
	--q-muted: color-mix(in oklab, <<colour foreground>> 70%, <<colour background>>);
	--q-faint: color-mix(in oklab, <<colour foreground>> 62%, <<colour background>>);

	/* Hairlines. `--q-line` is incidental (cells, fields); `--q-rule` is the
	   separator between one tiddler and the next — in a frameless theme that is
	   the only structural device there is, and it used to sit at 1.21:1, which
	   is to say it wasn't there. */
	--q-line: color-mix(in oklab, <<colour foreground>> 20%, <<colour background>>);
	--q-rule: color-mix(in oklab, <<colour foreground>> 28%, <<colour background>>);
	--q-tint: color-mix(in oklab, <<colour foreground>> 6%, transparent);

	/*
	** The accent. Links rest at `--q-accent-ink` and hover DEEPER, not lighter:
	** the old hover swapped to the raw primary, taking a link from 7.66:1 to
	** 4.40:1 on the light palette, so hovering made it harder to read.
	*/
	--q-accent: <<colour primary>>;
	--q-accent-ink: color-mix(in oklab, <<colour primary>> 52%, <<colour foreground>>);
	--q-accent-deep: color-mix(in oklab, <<colour primary>> 40%, <<colour foreground>>);
	--q-cta: color-mix(in oklab, <<colour primary>> 82%, <<colour foreground>>);
	--q-wash: color-mix(in oklab, <<colour primary>> 8%, transparent);
	--q-wash-strong: color-mix(in oklab, <<colour primary>> 15%, transparent);

	/* Elevation — only for surfaces that genuinely float, and palette-derived
	   rather than hard-coded rgba(0,0,0), which ignored the palette entirely. */
	--q-lift: 0 6px 24px color-mix(in oklab, <<colour foreground>> 14%, transparent);
	--q-lift-high: 0 14px 44px color-mix(in oklab, <<colour foreground>> 22%, transparent);

	/* Shape — the softest in the family, deliberately */
	--q-radius: 10px;
	--q-radius-sm: 6px;

	/* Space — 4pt scale */
	--q-space-3xs: 0.25rem;
	--q-space-2xs: 0.5rem;
	--q-space-xs: 0.75rem;
	--q-space-sm: 1rem;
	--q-space-md: 1.5rem;
	--q-space-lg: 2.5rem;
	--q-space-xl: 4rem;

	/* The reading column. Overridable from the ControlPanel — see settings.tid. */
	--q-measure: 40rem;

	/*
	** Type — one family, on purpose. This theme has no separate "interface
	** voice": the chrome is set in the same face as the prose because the
	** interface is meant to disappear into the page. Mono carries code only.
	**
	** "Source Sans 3" led the stack before; it is a banned default AND is not
	** installed on any of the three platforms, so the declaration bought
	** nothing and fell through to the next entry regardless.
	**   macOS: Seravek · Windows: Segoe UI Variable Text · Linux: Cantarell
	*/
	--q-sans: Seravek, "Segoe UI Variable Text", "Segoe UI", Cantarell,
		"Avenir Next", ui-sans-serif, system-ui, sans-serif;
	--q-mono: ui-monospace, "Cascadia Code", "SF Mono", Menlo, Consolas, monospace;

	/* Motion — a fade, and nothing else. Quiet is a claim this theme has to
	   keep; sliding panels in was arguing with it. */
	--q-ease: cubic-bezier(0.16, 1, 0.3, 1);
	--q-dur: 220ms;
	--q-slow: 380ms;

	accent-color: <<colour primary>>;
	caret-color: <<colour primary>>;
}

/* Fallback for browsers without color-mix(): map the muted tones, hairlines and
   accent ladder to solid palette colours so the calm reading surface stays
   legible (the faint accent tints simply drop out). */
@supports not (color: color-mix(in oklab, red, blue)) {
	:root {
		--q-muted: <<colour muted-foreground>>;
		--q-faint: <<colour muted-foreground>>;
		--q-line: <<colour tiddler-border>>;
		--q-rule: <<colour muted-foreground>>;
		--q-tint: transparent;
		--q-accent-ink: <<colour primary>>;
		--q-accent-deep: <<colour primary>>;
		--q-cta: <<colour primary>>;
		--q-wash: transparent;
		--q-wash-strong: transparent;
		--q-lift: 0 6px 24px rgba(0,0,0,0.16);
		--q-lift-high: 0 14px 44px rgba(0,0,0,0.24);
	}
}


html {
	scroll-behavior: smooth;
	background-color: <<colour page-background>>;
	/* Hand the page (viewport) scrollbar back to the browser so it follows the
	   palette's `color-scheme` on :root. The `* { scrollbar-color }` rule below
	   themes inner scrollbars, but applied to the root it overrides the native
	   colour-scheme scrollbar and leaves the page scrollbar light on dark palettes
	   (notably in TiddlyDesktop). Resetting it restores the native dark bar. */
	scrollbar-color: initial;
}

* {
	scrollbar-width: thin;
	scrollbar-color: var(--q-line) transparent;
}
*::-webkit-scrollbar { width: 10px; height: 10px; }
*::-webkit-scrollbar-thumb {
	background: var(--q-line);
	border-radius: var(--q-radius-sm);
	border: 3px solid transparent;
	background-clip: content-box;
}
*::-webkit-scrollbar-thumb:hover {
	background: var(--q-faint);
	background-clip: content-box;
}
*::-webkit-scrollbar-corner { background: transparent; }

::selection { background: var(--q-wash-strong); }

/* Focus ring — never transitioned: a ring that fades in leaves a keyboard user
   with no indicator for the length of the fade. */
:where(button, input, textarea, select, a):focus-visible {
	outline: 2px solid var(--q-accent);
	outline-offset: 2px;
	border-radius: var(--q-radius-sm);
}

@media (prefers-reduced-motion: reduce) {
	*, *::before, *::after {
		animation-duration: 0.001ms !important;
		animation-iteration-count: 1 !important;
		transition-duration: 0.001ms !important;
	}
}
