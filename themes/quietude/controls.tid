title: $:/themes/tiddlywiki/quietude/controls
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** Buttons, tags, controls, overlays, inputs & sidebar — quiet
*/

/* A fade, and nothing else. Panels used to slide up 6px on arrival, which is
   motion a theme called Quietude has to justify and can't. */
@keyframes q-fade {
	from { opacity: 0; }
	to   { opacity: 1; }
}

/* Toolbar icons — soft, unobtrusive */
.tc-tiddler-controls button,
.tc-page-controls button,
.tc-topbar button {
	border-radius: var(--q-radius-sm);
	transition: background-color var(--q-dur) var(--q-ease);
}
.tc-tiddler-controls button:hover,
.tc-page-controls button:hover,
.tc-topbar button:hover { background: var(--q-tint); }
.tc-tiddler-controls button:hover svg,
.tc-page-controls button:hover svg,
.tc-topbar button:hover svg { fill: var(--q-accent-deep); }

/* Standard buttons — soft, calm hover */
button.tc-btn-standard,
.tc-btn-boxed,
.tc-btn-rounded {
	font-family: var(--q-sans);
	border-radius: var(--q-radius-sm);
	border: 1px solid var(--q-line);
	transition: background-color var(--q-dur) var(--q-ease),
		border-color var(--q-dur) var(--q-ease);
}
button.tc-btn-standard:hover,
.tc-btn-boxed:hover,
.tc-btn-rounded:hover { background: var(--q-tint); border-color: var(--q-rule); }
button.tc-btn-standard:active,
.tc-btn-boxed:active,
.tc-btn-rounded:active { background: var(--q-wash); }

/* Primary — gentle and solid. `filter: brightness(1.06)` on hover is replaced
   by a real colour step: a filter forces a new rendering layer and its result
   on an already-mixed colour is not predictable across palettes. */
.tc-btn-big-green,
.tc-primary-btn,
button.tc-btn-big-green {
	font-family: var(--q-sans);
	background: var(--q-cta) !important;
	color: <<colour background>> !important;
	border: 1px solid var(--q-cta) !important;
	border-radius: var(--q-radius-sm);
	transition: background-color var(--q-dur) var(--q-ease),
		border-color var(--q-dur) var(--q-ease);
}
.tc-btn-big-green svg, .tc-primary-btn svg { fill: <<colour background>> !important; }
.tc-btn-big-green:hover, .tc-primary-btn:hover {
	background: var(--q-accent-ink) !important;
	border-color: var(--q-accent-ink) !important;
}
.tc-btn-big-green:active, .tc-primary-btn:active {
	background: var(--q-accent-deep) !important;
	border-color: var(--q-accent-deep) !important;
}

/* Disabled — three channels, never opacity alone */
button:disabled,
button[aria-disabled="true"],
input:disabled,
textarea:disabled,
select:disabled {
	opacity: 0.55;
	cursor: not-allowed;
	border-color: var(--q-line);
}
button:disabled:hover,
button[aria-disabled="true"]:hover {
	background: none;
	border-color: var(--q-line);
}

/* Tags — soft, quiet labels (doubled class beats vanilla).
   TiddlyWiki sets the tag's text colour INLINE (contrastcolour vs the palette's
   default tag-background). Since we restyle the background, we must override
   that inline colour with !important so text always contrasts with OUR chip.
   The background stays non-important so user-coloured tags keep their fill. */
.tc-tag-label.tc-tag-label:not([style*="background-color"]),
.tc-tag-label.tc-tag-label[style*="background-color:;"],
.tc-tag-label.tc-tag-label[style*="background-color: ;"] {
	background-color: var(--q-tint);
	color: <<colour foreground>> !important;
	fill: <<colour foreground>> !important;
	box-shadow: inset 0 0 0 1px var(--q-line);
}
.tc-tag-label.tc-tag-label:not([style*="background-color"]):hover,
.tc-tag-label.tc-tag-label[style*="background-color:;"]:hover,
.tc-tag-label.tc-tag-label[style*="background-color: ;"]:hover {
	background-color: var(--q-wash);
	box-shadow: inset 0 0 0 1px var(--q-rule);
}
.tc-tag-label.tc-tag-label:not([style*="background-color"]) svg,
.tc-tag-label.tc-tag-label[style*="background-color:;"] svg,
.tc-tag-label.tc-tag-label[style*="background-color: ;"] svg { fill: <<colour foreground>> !important; }

/* Themed shape + a subtle defining edge on every tag. Coloured tags
   (#hex, rgb(), or a named colour like GreenYellow) keep their own fill
   and contrastcolour text and gain this edge; the uncoloured chip above
   overrides the box-shadow with its own. */
.tc-tag-label.tc-tag-label {
	font-family: var(--q-sans);
	border-radius: var(--q-radius-sm);
	box-shadow: inset 0 0 0 1px var(--q-line);
	transition: background-color var(--q-dur) var(--q-ease),
		box-shadow var(--q-dur) var(--q-ease);
}

.tc-untagged-label { border-radius: var(--q-radius-sm); }

/* Dropdowns — opaque, softly raised, palette-derived shadow */
.tc-drop-down,
.tc-block-dropdown {
	font-family: var(--q-sans);
	border-radius: var(--q-radius);
	border: 1px solid var(--q-line);
	background: <<colour dropdown-background>>;
	box-shadow: var(--q-lift);
	padding: var(--q-space-3xs);
	animation: q-fade var(--q-dur) var(--q-ease) both;
}
.tc-drop-down a.tc-tiddlylink,
.tc-drop-down button,
.tc-drop-down .tc-dropdown-item,
.tc-block-dropdown a.tc-tiddlylink {
	border-radius: var(--q-radius-sm);
	transition: background-color var(--q-dur) var(--q-ease);
}
/* Contrast-safe hover: vanilla pairs a primary background with near-white text;
   since we replace the background with a soft wash, restore a contrasting ink. */
.tc-drop-down a:hover,
.tc-drop-down button:hover,
.tc-drop-down .tc-btn-invisible:hover,
.tc-drop-down .tc-file-input-wrapper:hover button,
.tc-block-dropdown a:hover,
.tc-block-tags-dropdown .tc-btn-invisible:hover {
	background: var(--q-wash-strong);
	color: var(--q-ink);
}
.tc-drop-down button.tc-btn-invisible:hover svg,
.tc-block-dropdown button.tc-btn-invisible:hover svg,
.tc-block-tags-dropdown .tc-btn-invisible:hover svg { fill: var(--q-ink); }
.tc-drop-down .tc-tab-divider, .tc-drop-down hr { border: none; height: 1px; background: var(--q-line); }

.tc-modal {
	border-radius: var(--q-radius);
	border: 1px solid var(--q-line);
	background: <<colour modal-background>>;
	box-shadow: var(--q-lift-high);
	overflow: hidden;
	animation: q-fade var(--q-slow) var(--q-ease) both;
}
.tc-modal-header { border-bottom: 1px solid var(--q-line); }
.tc-modal-footer { border-top: 1px solid var(--q-line); background: var(--q-tint); }

.tc-notification {
	border-radius: var(--q-radius);
	border: 1px solid var(--q-line);
	background: <<colour notification-background>>;
	box-shadow: var(--q-lift);
	animation: q-fade var(--q-dur) var(--q-ease) both;
}
.tc-alert { border-radius: var(--q-radius); }

/* Info panel — follows the reading column rather than going full-bleed, and
   arrives without an animation: it is inline content, not a floating surface. */
.tc-tiddler-info {
	border-radius: var(--q-radius);
	border: 1px solid var(--q-line);
	background: var(--q-tint);
	margin-inline: auto;
	max-width: var(--q-measure);
}

/*
** Inputs — calm fields.
**
** The border shift is decoration and may transition. The focus RING is the
** accessibility indicator and must not: it comes from the `:focus-visible`
** outline in variables.tid, which is never transitioned. These rules
** deliberately do NOT set `outline: none` — an attribute selector plus
** `:focus` outranks the zero-specificity `:where(...):focus-visible` base rule,
** so suppressing the outline here would leave keyboard users with a ring that
** fades in, which is to say with no ring at the moment they need one.
*/
input[type="text"],
input[type="search"],
input.tc-edit-texteditor,
textarea.tc-edit-texteditor,
.tc-edit-texteditor,
select {
	border-radius: var(--q-radius-sm);
	transition: border-color var(--q-dur) var(--q-ease);
}
input[type="text"]:focus,
input[type="search"]:focus,
input.tc-edit-texteditor:focus,
textarea.tc-edit-texteditor:focus,
.tc-edit-texteditor:focus {
	border-color: var(--q-accent);
}
.tc-edit-tags { border-radius: var(--q-radius-sm); }

/* Tabs */
.tc-tab-buttons button {
	font-family: var(--q-sans);
	border-radius: var(--q-radius-sm) var(--q-radius-sm) 0 0;
	transition: color var(--q-dur) var(--q-ease);
}
.tc-tab-buttons button:hover { color: var(--q-accent-deep); }
.tc-tab-buttons button.tc-tab-selected {
	color: <<colour foreground>>;
	box-shadow: inset 0 -2px 0 var(--q-accent);
}

.tc-plugin-info {
	border-radius: var(--q-radius);
	border-color: var(--q-line);
	box-shadow: none;
	transition: border-color var(--q-dur) var(--q-ease),
		background-color var(--q-dur) var(--q-ease);
}
/* Override vanilla's flood-fill hover (0,3,1) with Quietude's quiet tint. */
a.tc-tiddlylink.tc-plugin-info:hover {
	background-color: var(--q-tint);
	color: <<colour foreground>>;
	fill: var(--q-accent-deep);
	border-color: var(--q-rule);
	box-shadow: none;
	text-decoration: none;
}
a.tc-tiddlylink.tc-plugin-info:hover > .tc-plugin-info-chunk > svg {
	fill: var(--q-accent-deep);
}
a.tc-tiddlylink.tc-plugin-info:hover > .tc-plugin-info-chunk .tc-plugin-info-stability {
	color: <<colour foreground>>;
	border-color: var(--q-line);
}

/*
** Sidebar — recessive, by the same rule the toolbar follows: muted INK, and
** only on pointers that can hover. It used to be `opacity: 0.7` on the whole
** scrollable, which dims the search field and buttons along with the text and
** leaves a touch user with a permanently faded sidebar and no way to restore it.
*/
.tc-site-title {
	font-family: var(--q-sans);
	font-style: normal;
	font-weight: 650;
	letter-spacing: -0.015em;
	font-size: clamp(1.5rem, 1.3rem + 1vw, 1.95rem);
	color: <<colour site-title-foreground>>;
	overflow-wrap: anywhere;
	min-width: 0;
}
.tc-site-subtitle { font-family: var(--q-sans); color: var(--q-faint); }

.tc-sidebar-lists a.tc-tiddlylink {
	border-radius: var(--q-radius-sm);
	transition: color var(--q-dur) var(--q-ease);
}
.tc-sidebar-lists a.tc-tiddlylink:hover { color: var(--q-accent-deep); }
.tc-sidebar-tab-open-item {
	border-radius: var(--q-radius-sm);
	transition: background-color var(--q-dur) var(--q-ease);
}
.tc-sidebar-tab-open-item:hover { background: var(--q-tint); }
.tc-sidebar-lists .tc-tab-buttons button { font-family: var(--q-sans); }
.tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected {
	color: <<colour foreground>>;
	box-shadow: inset 0 -2px 0 var(--q-accent);
}

@media (hover: hover) and (pointer: fine) {
	.tc-sidebar-lists a.tc-tiddlylink,
	.tc-sidebar-lists .tc-tab-buttons button {
		color: var(--q-faint);
	}
	.tc-sidebar-scrollable:hover .tc-sidebar-lists a.tc-tiddlylink,
	.tc-sidebar-scrollable:focus-within .tc-sidebar-lists a.tc-tiddlylink {
		color: var(--q-ink);
	}
	/* The selected tab keeps its full ink at all times — it is state, not chrome */
	.tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected {
		color: <<colour foreground>>;
	}
}

.tc-sidebar-header .tc-search input,
.tc-search input {
	font-family: var(--q-sans);
	border-radius: var(--q-radius-sm);
	border: 1px solid var(--q-line);
	transition: border-color var(--q-dur) var(--q-ease);
}
.tc-sidebar-header .tc-search input:focus,
.tc-search input:focus { border-color: var(--q-accent); }

.tc-page-controls { gap: var(--q-space-3xs); }
