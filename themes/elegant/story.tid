title: $:/themes/tiddlywiki/elegant/story
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** Story river & tiddler frame — the folio
**
** The river is a single continuous leaf of paper standing on the darker page
** beneath it, edged with a hairline fore-edge. Tiddlers are sections of that
** leaf: no border of their own, no surface of their own, no shadow, no hover.
** What separates them is a head rule and a generous band of whitespace.
*/

/* The leaf. Vanilla already pads the river at 42px on desktop and 0 on mobile;
   we take the vertical padding up so the first head rule has room to breathe. */
.tc-story-river {
	padding-top: var(--e-space-xl);
	padding-bottom: var(--e-space-2xl);
	background: var(--e-paper);
	border-inline: 1px solid var(--e-rule);
}

/*
** Tiddler frame.
**
** The story views drive this exact node with inline transform/opacity, and
** TiddlyWiki anchors toolbar popups through it, so it must stay free of
** `transform`, `will-change`, `animation` and new `position` contexts.
**
** The frame is now purely a measure and a rhythm: it holds the reading column
** to ~68 characters and centres it on the leaf. Vanilla sets an explicit
** `width` here from ThemeTweaks; our max-width caps that to the measure. To
** widen the column, override `--e-measure` rather than the tiddler width.
*/
.tc-tiddler-frame {
	--e-frame-pad-x: var(--e-space-lg);
	max-width: calc(var(--e-measure) + 2 * var(--e-frame-pad-x));
	margin-inline: auto;
	/* Generous above, tighter below: the band of space belongs to the head rule
	   of the section that follows, not to the text that just ended. */
	margin-bottom: var(--e-space-xl);
	padding: var(--e-space-lg) var(--e-frame-pad-x) var(--e-space-xs);
	background: none;
	border: none;
	border-radius: 0;
	box-shadow: none;
}

/* Edit mode is the one state that earns a box — it is a different mode, and it
   should be unmistakable which tiddler has your changes in it. */
.tc-tiddler-frame.tc-tiddler-edit-frame {
	background: var(--e-tint);
	border: 1px solid var(--e-rule-strong);
	padding-bottom: var(--e-space-md);
}

@media (max-width: 769px) {
	.tc-story-river {
		padding-top: var(--e-space-lg);
		padding-bottom: var(--e-space-xl);
		padding-inline: var(--e-space-2xs);
		border-inline: none;
	}
	/* Keep a real gutter rather than collapsing to zero: the fold banner is
	   positioned into it, and vanilla sizes that banner at 16px on mobile. */
	.tc-tiddler-frame {
		--e-frame-pad-x: var(--e-space-sm);
		margin-bottom: var(--e-space-lg);
		padding: var(--e-space-md) var(--e-frame-pad-x) var(--e-space-2xs);
	}
}

/*
** Title block. The rule sits ABOVE the title — a head rule opening a section,
** the way a printed page opens a chapter — rather than underlining it. Nothing
** rules off the title from its own body; whitespace does that work.
*/
.tc-tiddler-title {
	margin-bottom: var(--e-space-md);
	padding-top: var(--e-space-md);
	border-top: 1px solid var(--e-rule-strong);
}

.tc-titlebar h2 {
	color: <<colour tiddler-title-foreground>>;
}

/* The byline: real small caps in the reading serif, generously letter-spaced.
   Set in the content register, because it is content — it says when this was
   written, not what the interface can do. */
.tc-tiddler-subtitle {
	font-family: var(--e-serif);
	font-variant-caps: all-small-caps;
	font-size: 0.86rem;
	letter-spacing: 0.1em;
	color: var(--e-faint);
}

/* Tags as a quiet line under the byline */
.tc-tags-wrapper {
	margin-top: var(--e-space-2xs);
}

/* The body opens a clear band below the title block */
.tc-tiddler-body {
	margin-top: var(--e-space-md);
}

/* Missing / shadow tiddler notes, kept understated */
.tc-tiddler-missing .tc-tiddler-body {
	color: var(--e-muted);
	font-style: italic;
}

/* Fold / unfold banners — vanilla positions both with negative margins sized to
   its own 42px frame padding, which is not our padding. Re-anchor them to the
   frame edge with left/right so they stay correct whatever the gutter is.
   Desktop only: on mobile vanilla lays the unfold banner out statically, and
   forcing it absolute there would strand it. */
@media (min-width: 770px) {
	.tc-unfold-banner.tc-unfold-banner {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		width: auto;
		-webkit-margin-start: 0;
		margin-inline-start: 0;
		border-radius: 0;
	}
	.tc-fold-banner.tc-fold-banner {
		inset-inline-start: 0;
		top: 0;
		bottom: 0;
		max-width: var(--e-frame-pad-x);
		-webkit-margin-start: 0;
		margin-inline-start: 0;
		border-radius: 0;
	}
}
