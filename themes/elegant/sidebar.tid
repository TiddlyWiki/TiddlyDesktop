title: $:/themes/tiddlywiki/elegant/sidebar
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** Sidebar
*/

.tc-sidebar-header {
	padding-top: var(--e-space-2xs);
}

/* Masthead: the display serif over a double rule — thick-thin, the way a
   printed masthead closes. It used to be a single hairline with a gradient
   sheen sliding across it on a nine-second loop; a decoration that never
   finishes pulls the eye forever and tells the reader nothing. */
.tc-site-title {
	font-size: clamp(1.7rem, 1.35rem + 1.1vw, 2.15rem);
	font-weight: 400;
	letter-spacing: -0.022em;
	color: <<colour site-title-foreground>>;
}

.tc-site-title::after {
	content: "";
	display: block;
	height: 3px;
	width: 100%;
	margin-top: 0.5rem;
	border-top: 2px solid var(--e-rule-strong);
	border-bottom: 1px solid var(--e-rule);
}

/* The strapline, in small caps — content register, like the tiddler byline */
.tc-site-subtitle {
	font-family: var(--e-serif);
	font-variant-caps: all-small-caps;
	font-size: 0.9rem;
	letter-spacing: 0.1em;
	color: var(--e-faint);
}

/* Sidebar tab buttons: the chrome sans, with a rule under the chosen one */
.tc-sidebar-lists .tc-tab-buttons button {
	font-family: var(--e-sans);
	font-size: 0.82em;
	letter-spacing: 0.04em;
	border-radius: 0;
	transition: color var(--e-dur) var(--e-ease);
}
.tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected {
	box-shadow: inset 0 -2px 0 var(--e-accent);
	color: var(--e-accent-deep);
}

/* Sidebar links: colour only. The 2px glide on hover made every list in the
   sidebar twitch under the pointer, which is motion with nothing to say. */
.tc-sidebar-lists a.tc-tiddlylink,
.tc-sidebar-lists .tc-tiddlylink {
	border-radius: var(--e-radius);
	transition: color var(--e-dur) var(--e-ease);
}
.tc-sidebar-lists a.tc-tiddlylink:hover {
	color: var(--e-accent);
}

/* Search: a slim square field that takes an accent edge on focus */
.tc-sidebar-header .tc-search input,
.tc-search input {
	font-family: var(--e-sans);
	border-radius: var(--e-radius);
	border: 1px solid var(--e-rule);
	background: var(--e-tint);
	transition: border-color var(--e-dur) var(--e-ease),
		background-color var(--e-dur) var(--e-ease);
}
/* Border and surface shift decoratively; the focus ring is the instant
   `:focus-visible` outline from variables.tid, so no `outline: none` here. */
.tc-sidebar-header .tc-search input:focus,
.tc-search input:focus {
	border-color: var(--e-accent);
	background: <<colour background>>;
}

/* Open-tiddler list rows */
.tc-sidebar-tab-open-item {
	border-radius: var(--e-radius);
	transition: background-color var(--e-fast) var(--e-ease);
}
.tc-sidebar-tab-open-item:hover {
	background: var(--e-tint);
}

/* Tab divider as a plain hairline */
.tc-sidebar-lists .tc-tab-set .tc-tab-divider {
	border: none;
	height: 1px;
	background: var(--e-rule);
}

.tc-page-controls {
	gap: var(--e-space-3xs);
}
