title: $:/themes/tiddlywiki/elegant/tiddlydesktop
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** TiddlyDesktop — Elegant theme
**
** The WikiList window is a catalogue: a column of entries ruled apart, not a
** deck of cards. Square corners, hairline edges, no shadows — the same
** print-native discipline the story river follows. Serif for the entry titles
** because they are content; sans for everything the window itself says.
*/

/* Toolbar — a quiet bar closed by a rule, no shadow */
.td-toolbar {
	box-shadow: none;
	border-bottom: 1px solid var(--e-rule-strong);
	font-family: var(--e-sans);
}

/* Wiki-list entries — hairline-edged, flat on the page. The shadow that used
   to lift them (and deepen on hover) implied they could be picked up; they
   can't, so the hover now just firms the edge. */
.td-wikilist .td-wikilist-item {
	border-radius: var(--e-radius);
	border: 1px solid var(--e-rule);
	box-shadow: none;
	transition: border-color var(--e-dur) var(--e-ease);
}
.td-wikilist .td-wikilist-item:hover {
	border-color: var(--e-rule-strong);
}
.td-wikilist .td-wikilist-item.tc-dragging {
	box-shadow: none;
}

/* Title — the display serif, set light like every other title in the theme */
.td-wikilist .td-wiki-title {
	font-family: var(--e-display);
	font-weight: 400;
	font-size: 1.2em;
	letter-spacing: -0.015em;
}
.td-wikilist .td-wikilist-info {
	font-family: var(--e-sans);
}

/* Buttons — square, quiet sans */
button.td-button {
	border-radius: var(--e-radius);
	font-family: var(--e-sans);
	font-size: 0.82em;
	transition: background-color var(--e-fast) var(--e-ease);
}

/* Toolbar inputs */
.td-toolbar input,
.td-toolbar select {
	font-family: var(--e-sans);
	border-radius: var(--e-radius);
}

/* ── The WikiList window — editorial chrome ──────────────────────────── */

/* Search field — square, hairline-ruled, quiet sans */
.td-search input.td-wikilist-search-input {
	font-family: var(--e-sans);
	border-radius: var(--e-radius);
	border: 1px solid var(--e-rule-strong);
	transition: border-color var(--e-fast) var(--e-ease);
}
.td-search input.td-wikilist-search-input:focus {
	border-color: var(--e-accent);
}

/* Filter tag pills share the toolbar's restrained sans */
.td-tags .tc-tag-label {
	font-family: var(--e-sans);
}

/* ── WikiList rows — ruled entries, tipped-in favicon ─────────────────── */

/* Favicon framed like a plate tipped into the page — a hairline mat, no lift */
.td-wikilist .td-wikilist-item .td-wikilist-thumbnail button {
	border-radius: var(--e-radius);
	border: 1px solid var(--e-rule);
	box-shadow: none;
}

/* The path is data, so it goes in the chrome sans rather than an italic serif */
.td-wikilist .td-wiki-url {
	font-family: var(--e-sans);
	font-style: normal;
	font-size: 0.82em;
	letter-spacing: 0.01em;
}

/* A hairline rule sets the row actions apart from the heading */
.td-wikilist .td-wikilist-item .td-wiki-toolbar {
	border-top: 1px solid var(--e-rule);
	padding-top: var(--e-space-2xs);
}

/* Advanced-panel headings in the quiet sans, matching the toolbar */
.td-wikilist .td-wiki-advanced-heading {
	font-family: var(--e-sans);
}
