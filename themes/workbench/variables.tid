/* Hallmark · genre: modern-minimal · macrostructure: Index-First · theme: Workbench
 * mood: utilitarian (tool, not object) · anchor hue: neutral — the accent is
 *       spent only where it carries meaning, so the grid carries the design
 * nav: n/a · footer: n/a — TiddlyWiki owns the chrome; a theme has neither.
 * pre-emit critique: P5 H5 E5 S5 R5 V4
 */

/*
** Workbench — design tokens
**
** A dense, utilitarian theme for large wikis and power users. The organising
** idea is a LEDGER: the story river is one continuous sheet ruled into
** records, not a stack of framed cards. Rules and alignment carry every bit
** of structure, which is why they are drawn strongly enough to actually see —
** the old grid lines sat at 1.5:1 against paper and effectively vanished.
**
** Colour is almost absent by design. The accent appears on links, the focus
** ring, and the one row that is currently active — nowhere else. Bullets,
** blockquotes, code, table headers, button hovers and tag hovers were all
** tinted with it before; a ledger that highlights everything highlights
** nothing, and the colour was doing no work that the grid wasn't already doing.
**
** Everything derives from the active palette via <<colour>> and color-mix(),
** mixed in OKLAB. Motion is fast, functional, and there is very little of it.
*/

:root {
	--w-ink: <<colour foreground>>;
	--w-panel: <<colour tiddler-background>>;

	/* Two DISTINCT secondary inks. These used to be two names for the same 50%
	   mix — byte-identical definitions — and both failed 4.5:1 on the 0.72rem
	   monospace metadata (3.24:1 light / 4.11:1 dark). They now differ in role
	   and both clear the floor in both palettes. */
	--w-muted: color-mix(in oklab, <<colour foreground>> 70%, <<colour background>>);
	--w-faint: color-mix(in oklab, <<colour foreground>> 62%, <<colour background>>);

	/* The grid. `--w-grid` is the interior hairline between cells; `--w-grid-strong`
	   is the record rule that separates one tiddler from the next and is the single
	   most load-bearing line in the theme, so it clears 3:1 as a real boundary. */
	--w-grid: color-mix(in oklab, <<colour foreground>> 22%, <<colour background>>);
	--w-grid-strong: color-mix(in oklab, <<colour foreground>> 48%, <<colour background>>);
	--w-zebra: color-mix(in oklab, <<colour foreground>> 4%, transparent);
	/* Neutral hover — rows track under the pointer without spending accent */
	--w-tint: color-mix(in oklab, <<colour foreground>> 7%, transparent);

	/* The accent, rationed. Three uses: links, focus, the active row. */
	--w-accent: <<colour primary>>;
	--w-accent-ink: color-mix(in oklab, <<colour primary>> 70%, <<colour foreground>>);
	--w-select: color-mix(in oklab, <<colour primary>> 12%, transparent);

	/* Elevation — palette-derived, not hard-coded black. A pure rgba(0,0,0,0.3)
	   shadow is harsh on the light palette and ignores the palette entirely. */
	--w-lift: 0 2px 10px color-mix(in oklab, <<colour foreground>> 16%, transparent);
	--w-lift-high: 0 8px 30px color-mix(in oklab, <<colour foreground>> 24%, transparent);

	/* Shape — square. A ledger has cells, and cells have corners. */
	--w-radius: 0;

	/* Space — 4pt scale */
	--w-space-3xs: 0.125rem;
	--w-space-2xs: 0.25rem;
	--w-space-xs: 0.5rem;
	--w-space-sm: 0.75rem;
	--w-space-md: 1rem;
	--w-space-lg: 1.5rem;

	/*
	** Density. The ControlPanel selector re-points these two tokens rather than
	** overriding a pile of rules with !important and hard-coded px — one switch,
	** and every record, row and cell follows it.
	*/
	--w-row-y: var(--w-space-sm);
	--w-row-x: var(--w-space-md);

	/*
	** Measure. Text is measured; data is not. At the 0.92rem body size this is
	** roughly 72 characters — a record can be as wide as the window, but a line
	** of prose inside it still has to be readable, and the default tiddler width
	** runs past 90 characters at this size. Tables, code blocks and images are
	** deliberately exempt: those are the ledger, and they take the full record.
	*/
	--w-measure: 33rem;

	/*
	** Type — mono is the display face and the system voice; sans is the reading
	** face and nothing else. The sans stack deliberately leads with the OS's own
	** UI font: a tool should look like the machine it runs on, and that is the
	** utilitarian answer rather than a decorative one. It used to name "Inter"
	** first, which is a banned default AND is not installed on most systems, so
	** the declaration bought nothing and silently fell through to system-ui anyway.
	*/
	--w-sans: ui-sans-serif, system-ui, "Segoe UI", "Helvetica Neue",
		"Liberation Sans", Arial, sans-serif;
	--w-mono: ui-monospace, "Cascadia Code", "JetBrains Mono", "SF Mono", Menlo,
		Consolas, monospace;

	/* Motion — fast and functional. Exponential ease-out rather than the Material
	   standard curve; nothing here moves far enough for the difference to be
	   decorative. */
	--w-ease: cubic-bezier(0.16, 1, 0.3, 1);
	--w-fast: 90ms;
	--w-dur: 140ms;

	accent-color: <<colour primary>>;
	caret-color: <<colour primary>>;
}

/* Fallback for browsers without color-mix(): map the grid lines, zebra striping,
   muted text and the accent ladder to solid palette colours so the ledger layout
   stays readable (the faint tints simply drop out). */
@supports not (color: color-mix(in oklab, red, blue)) {
	:root {
		--w-muted: <<colour muted-foreground>>;
		--w-faint: <<colour muted-foreground>>;
		--w-grid: <<colour tiddler-border>>;
		--w-grid-strong: <<colour muted-foreground>>;
		--w-zebra: transparent;
		--w-tint: transparent;
		--w-accent-ink: <<colour primary>>;
		--w-select: transparent;
		--w-lift: 0 2px 10px rgba(0,0,0,0.24);
		--w-lift-high: 0 8px 30px rgba(0,0,0,0.34);
	}
}


/* Tabular, monospace-leaning numerals everywhere data appears */
.tc-tiddler-subtitle, .tc-tiddler-body table, .tc-view-field-table, .tc-edit-fields {
	font-variant-numeric: tabular-nums;
}

html {
	scroll-behavior: smooth;
	background-color: <<colour page-background>>;
	/* Hand the page (viewport) scrollbar back to the browser so it follows the
	   palette's `color-scheme` on :root. The `* { scrollbar-color }` rule below
	   themes inner scrollbars, but applied to the root it overrides the native
	   colour-scheme scrollbar and leaves the page scrollbar light on dark palettes
	   (notably in TiddlyDesktop). Resetting it restores the native dark bar. */
	scrollbar-color: initial;
}

* {
	scrollbar-width: thin;
	scrollbar-color: var(--w-grid-strong) transparent;
}
*::-webkit-scrollbar { width: 10px; height: 10px; }
*::-webkit-scrollbar-thumb {
	background: var(--w-grid-strong);
	border-radius: var(--w-radius);
	border: 2px solid transparent;
	background-clip: content-box;
}
*::-webkit-scrollbar-thumb:hover {
	background: var(--w-ink);
	background-clip: content-box;
}
*::-webkit-scrollbar-corner { background: transparent; }

::selection { background: var(--w-select); }

/* Focus ring — one of the three things the accent is spent on. Never
   transitioned: a ring that fades in leaves a keyboard user with no indicator
   for the length of the fade. */
:where(button, input, textarea, select, a):focus-visible {
	outline: 2px solid var(--w-accent);
	outline-offset: 1px;
	border-radius: var(--w-radius);
}

@media (prefers-reduced-motion: reduce) {
	*, *::before, *::after {
		animation-duration: 0.001ms !important;
		animation-iteration-count: 1 !important;
		transition-duration: 0.001ms !important;
	}
}
