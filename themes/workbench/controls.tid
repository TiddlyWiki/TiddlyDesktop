title: $:/themes/tiddlywiki/workbench/controls
tags: [[$:/tags/Stylesheet]]

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/*
** Buttons, tags, controls, overlays, inputs & sidebar — dense
**
** Everything that used to hover, select or activate with an accent wash now
** does it with a neutral tint. The accent survives in exactly three places:
** links, the focus ring, and whatever is currently ACTIVE — the selected tab,
** the record being edited. A console that tints every hover teaches the eye
** to ignore the colour, which defeats the point of having one.
*/

/* Toolbar icons — tight, neutral, quick */
.tc-tiddler-controls button,
.tc-page-controls button,
.tc-topbar button {
	border-radius: var(--w-radius);
	transition: background-color var(--w-fast) var(--w-ease);
}
.tc-tiddler-controls button svg,
.tc-page-controls button svg,
.tc-topbar button svg {
	transition: fill var(--w-fast) var(--w-ease);
}
.tc-tiddler-controls button:hover,
.tc-page-controls button:hover,
.tc-topbar button:hover { background: var(--w-tint); }
.tc-tiddler-controls button:hover svg,
.tc-page-controls button:hover svg,
.tc-topbar button:hover svg { fill: var(--w-ink); }

/* Standard buttons — compact, square, monospace label */
button.tc-btn-standard,
.tc-btn-boxed,
.tc-btn-rounded {
	border-radius: var(--w-radius);
	border: 1px solid var(--w-grid-strong);
	padding: 0.2em 0.6em;
	font-family: var(--w-mono);
	font-size: 0.86em;
	transition: background-color var(--w-fast) var(--w-ease),
		border-color var(--w-fast) var(--w-ease);
}
button.tc-btn-standard:hover,
.tc-btn-boxed:hover,
.tc-btn-rounded:hover { background: var(--w-tint); border-color: var(--w-ink); }
button.tc-btn-standard:active,
.tc-btn-boxed:active,
.tc-btn-rounded:active { background: var(--w-grid); }

/*
** Primary — flat and solid. The fill is the link ink, which already clears
** 4.5:1 against `<<colour background>>` text in both palettes; hover steps up
** to the raw accent, which also passes. This replaces `filter: brightness(1.08)`
** — a filter forces a new rendering layer and its result on an already-mixed
** colour is not predictable across palettes.
*/
.tc-btn-big-green,
.tc-primary-btn,
button.tc-btn-big-green {
	background: var(--w-accent-ink) !important;
	color: <<colour background>> !important;
	border: 1px solid var(--w-accent-ink) !important;
	border-radius: var(--w-radius);
	font-family: var(--w-mono);
	transition: background-color var(--w-fast) var(--w-ease),
		border-color var(--w-fast) var(--w-ease);
}
.tc-btn-big-green svg, .tc-primary-btn svg { fill: <<colour background>> !important; }
.tc-btn-big-green:hover, .tc-primary-btn:hover {
	background: var(--w-accent) !important;
	border-color: var(--w-accent) !important;
}
.tc-btn-big-green:active, .tc-primary-btn:active {
	background: var(--w-accent-ink) !important;
	border-color: var(--w-ink) !important;
}

/* Disabled — three channels, never opacity alone */
button:disabled,
button[aria-disabled="true"],
input:disabled,
textarea:disabled,
select:disabled {
	opacity: 0.55;
	cursor: not-allowed;
	border-color: var(--w-grid);
}
button:disabled:hover,
button[aria-disabled="true"]:hover {
	background: none;
	border-color: var(--w-grid);
}

/* Tags — compact monospace labels (doubled class beats vanilla).
   TiddlyWiki sets the tag's text colour INLINE (contrastcolour vs the palette's
   default tag-background). Since we restyle the background, we must override that
   inline colour with !important so text always contrasts with OUR chip. The
   background stays non-important so user-coloured tags keep their own fill. */
.tc-tag-label.tc-tag-label:not([style*="background-color"]),
.tc-tag-label.tc-tag-label[style*="background-color:;"],
.tc-tag-label.tc-tag-label[style*="background-color: ;"] {
	background-color: transparent;
	color: <<colour foreground>> !important;
	fill: <<colour foreground>> !important;
	box-shadow: inset 0 0 0 1px var(--w-grid-strong);
}
.tc-tag-label.tc-tag-label:not([style*="background-color"]):hover,
.tc-tag-label.tc-tag-label[style*="background-color:;"]:hover,
.tc-tag-label.tc-tag-label[style*="background-color: ;"]:hover {
	background-color: var(--w-tint);
	box-shadow: inset 0 0 0 1px var(--w-ink);
}
.tc-tag-label.tc-tag-label:not([style*="background-color"]) svg,
.tc-tag-label.tc-tag-label[style*="background-color:;"] svg,
.tc-tag-label.tc-tag-label[style*="background-color: ;"] svg { fill: <<colour foreground>> !important; }

/* Themed shape + a subtle defining edge on every tag. Coloured tags
   (#hex, rgb(), or a named colour like GreenYellow) keep their own fill
   and contrastcolour text and gain this edge; the uncoloured chip above
   overrides the box-shadow with its grid border. */
.tc-tag-label.tc-tag-label {
	border-radius: var(--w-radius);
	box-shadow: inset 0 0 0 1px var(--w-grid-strong);
	font-family: var(--w-mono);
	font-size: 0.82em;
	transition: background-color var(--w-fast) var(--w-ease),
		box-shadow var(--w-fast) var(--w-ease);
}

.tc-untagged-label { border-radius: var(--w-radius); }

/* Dropdowns — tight rows, contrast-safe hover, palette-derived elevation */
.tc-drop-down,
.tc-block-dropdown {
	border-radius: var(--w-radius);
	border: 1px solid var(--w-grid-strong);
	background: <<colour dropdown-background>>;
	box-shadow: var(--w-lift);
	padding: var(--w-space-3xs);
}
.tc-drop-down a.tc-tiddlylink,
.tc-drop-down button,
.tc-drop-down .tc-dropdown-item,
.tc-block-dropdown a.tc-tiddlylink { border-radius: var(--w-radius); }
/* Hover rows: vanilla pairs a primary background with near-white text; since we
   replace the background with a neutral tint, we must restore a contrasting
   foreground (and icon fill) so the text never sits white-on-pale. */
.tc-drop-down a:hover,
.tc-drop-down button:hover,
.tc-drop-down .tc-btn-invisible:hover,
.tc-drop-down .tc-file-input-wrapper:hover button,
.tc-block-dropdown a:hover,
.tc-block-tags-dropdown .tc-btn-invisible:hover {
	background: var(--w-tint);
	color: var(--w-ink);
}
.tc-drop-down button.tc-btn-invisible:hover svg,
.tc-block-dropdown button.tc-btn-invisible:hover svg,
.tc-block-tags-dropdown .tc-btn-invisible:hover svg { fill: var(--w-ink); }
.tc-drop-down .tc-tab-divider, .tc-drop-down hr { border: none; height: 1px; background: var(--w-grid); }

.tc-modal {
	border-radius: var(--w-radius);
	border: 1px solid var(--w-grid-strong);
	background: <<colour modal-background>>;
	box-shadow: var(--w-lift-high);
	overflow: hidden;
}
.tc-modal-header { border-bottom: 1px solid var(--w-grid); }
.tc-modal-footer { border-top: 1px solid var(--w-grid); }
.tc-notification {
	border-radius: var(--w-radius);
	border: 1px solid var(--w-grid-strong);
	background: <<colour notification-background>>;
	box-shadow: var(--w-lift);
}
.tc-alert { border-radius: var(--w-radius); }

/* Info panel — full-bleed to the record edges via the gutter variable, then
   re-padded so its content lines up with the body above it. */
.tc-tiddler-info {
	margin-inline: calc(var(--w-frame-pad-x, 0px) * -1);
	padding-inline: var(--w-frame-pad-x, 0px);
	border-radius: 0;
	border: none;
	border-top: 1px solid var(--w-grid);
	border-bottom: 1px solid var(--w-grid);
	background: var(--w-zebra);
}

/*
** Inputs — compact monospace fields.
**
** The border shift is decoration and may transition. The focus RING is the
** accessibility indicator and must not: it comes from the `:focus-visible`
** outline in variables.tid, which is never transitioned. These rules
** deliberately do NOT set `outline: none` — an attribute selector plus
** `:focus` outranks the zero-specificity `:where(...):focus-visible` base rule,
** so suppressing the outline here would leave keyboard users with a ring that
** fades in, which is to say with no ring at the moment they need one.
*/
input[type="text"],
input[type="search"],
input.tc-edit-texteditor,
textarea.tc-edit-texteditor,
.tc-edit-texteditor,
select {
	border-radius: var(--w-radius);
	transition: border-color var(--w-dur) var(--w-ease);
}
input.tc-edit-texteditor, textarea.tc-edit-texteditor, .tc-edit-texteditor { font-family: var(--w-mono); }
input[type="text"]:focus,
input[type="search"]:focus,
input.tc-edit-texteditor:focus,
textarea.tc-edit-texteditor:focus,
.tc-edit-texteditor:focus {
	border-color: var(--w-accent);
}
.tc-edit-tags { border-radius: var(--w-radius); }

/* Tabs — the selected tab is an active row, so it keeps the accent underline */
.tc-tab-buttons button {
	border-radius: var(--w-radius);
	font-family: var(--w-mono);
	font-size: 0.9em;
	transition: color var(--w-fast) var(--w-ease), background-color var(--w-fast) var(--w-ease);
}
.tc-tab-buttons button:hover { background: var(--w-tint); }
.tc-tab-buttons button.tc-tab-selected {
	color: <<colour foreground>>;
	box-shadow: inset 0 -2px 0 var(--w-accent);
}

.tc-plugin-info {
	border-radius: var(--w-radius);
	border-color: var(--w-grid-strong);
	transition: border-color var(--w-dur) var(--w-ease);
}
/* Override vanilla's flood-fill hover (0,3,1) with Workbench's grid treatment. */
a.tc-tiddlylink.tc-plugin-info:hover {
	background-color: var(--w-tint);
	color: <<colour foreground>>;
	fill: <<colour foreground>>;
	border-color: var(--w-ink);
	text-decoration: none;
}
a.tc-tiddlylink.tc-plugin-info:hover > .tc-plugin-info-chunk > svg {
	fill: <<colour foreground>>;
}
a.tc-tiddlylink.tc-plugin-info:hover > .tc-plugin-info-chunk .tc-plugin-info-stability {
	color: <<colour foreground>>;
	border-color: <<colour tiddler-border>>;
}

/*
** Sidebar — compact console
*/
.tc-site-title {
	font-family: var(--w-mono);
	font-style: normal;
	font-weight: 600;
	font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.55rem);
	color: <<colour site-title-foreground>>;
	overflow-wrap: anywhere;
	min-width: 0;
}
.tc-site-subtitle {
	font-family: var(--w-mono);
	font-size: 0.74rem;
	color: var(--w-faint);
}

.tc-sidebar-lists a.tc-tiddlylink {
	border-radius: var(--w-radius);
	transition: color var(--w-fast) var(--w-ease), background-color var(--w-fast) var(--w-ease);
}
.tc-sidebar-lists a.tc-tiddlylink:hover { color: var(--w-ink); background: var(--w-tint); }
.tc-sidebar-tab-open-item { border-radius: var(--w-radius); }
.tc-sidebar-tab-open-item:hover { background: var(--w-tint); }
.tc-sidebar-lists .tc-tab-buttons button { font-family: var(--w-mono); font-size: 0.82em; }
.tc-sidebar-lists .tc-tab-buttons button.tc-tab-selected {
	color: <<colour foreground>>;
	box-shadow: inset 0 -2px 0 var(--w-accent);
}
.tc-sidebar-lists .tc-tab-set .tc-tab-divider {
	border: none;
	height: 1px;
	background: var(--w-grid);
}

.tc-sidebar-header .tc-search input,
.tc-search input {
	border-radius: var(--w-radius);
	border: 1px solid var(--w-grid-strong);
	font-family: var(--w-mono);
	font-size: 0.86em;
	transition: border-color var(--w-dur) var(--w-ease);
}
.tc-sidebar-header .tc-search input:focus,
.tc-search input:focus { border-color: var(--w-accent); }

.tc-page-controls { gap: var(--w-space-3xs); }
